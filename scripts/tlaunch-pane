#!/usr/bin/env python3
"""Run one command in a tmux pane, and stand in for it where launch can see it.

Launch owns the processes it starts: it knows their pids, signals them and reads
their exit codes. A command running in a tmux pane is owned by the tmux server
instead, so launch would see nothing of it. This script bridges the two --
launch runs *this*, this runs the real command in a pane of the window it was
given, and ends the way the command did:

    tlaunch-pane --window sess:win --title /demo/turtlesim -- prog arg arg

Inside the pane the command runs under `lte-run` (from libtmux_easy), which is
its real parent: it reads the exact exit status with waitpid and reports it
here over a unix socket, and signals sent here are passed to it the same way.
So from launch's side the process behaves normally -- a pid, signals that
reach the command, the real exit code or killing signal -- with no polling of
tmux and no shell in between to blur "exit 130" into "SIGINT". Meanwhile its
output and its terminal are a pane you can look at -- a *real* terminal, which
stock launch cannot offer, so a curses program like `turtle_teleop_key` works.

The pane is made here rather than by tlaunch for one reason: the tmux server
forks the pane's process, and it would use the *server's* environment. Launch
computes an environment per process (ROS needs it, and any
`SetEnvironmentVariable` in the launch file is in it) and hands it to this
script, which passes it on explicitly. tlaunch only makes the window.

The pane's output also comes back here: `lte-run --tee` copies it, as plain
text, to a FIFO this script reads, and this script writes it to its own stdout
-- which is where launch reads a process's output. So a process in a pane
still reaches launch's log files, the death report's last lines, and a
session's `wait_output()`. lte-run sets the copy up (tmux's `pipe-pane`)
before it starts the command, so not even its first line is missed, and has
written the last of it before it reports the exit.

If no pane can be had at all -- no room, no tmux, a window that has gone away
-- the command is run here instead, exactly as launch would have run it. A pane
is a convenience, and losing one is not worth losing the process.

Nothing here imports ros2_typed_launch (or anything outside the standard
library): one of these runs per launched process, so it has to start fast.
"""

import argparse
import json
import os
import select
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time

#: The lte-run protocol (libtmux_easy/wrap.py) this script speaks.
DIR_ENV = "LTE_DIR"
SOCKET_NAME = "ctl.sock"

#: How long lte-run gets to call in once its pane exists.
CONNECT = 10.0

#: After the first forwarded signal, how long the command gets before it is
#: sent SIGKILL. Launch sends SIGTERM 5 s after SIGINT and SIGKILL 5 s after
#: that -- but SIGKILL lands on *this* script and cannot be passed on, so the
#: command has to be killed from here before launch gets that far.
GRACE = 8.0

#: Pane options describing this process, read by tlaunch (its end-of-run
#: tidy-up, and the dashboard's status file -- see tmux.py). tmux's own
#: #{pane_dead_status} is occasionally never set, so the status is recorded
#: here: the exit code, or minus the killing signal. STOPPED is the last
#: signal passed on from launch: a command that ends after one was asked to
#: stop, and is not a failure worth keeping the pane for.
OPTION = {
    "name": "@tlaunch_name",          # pane title: node FQN or process name
    "window": "@tlaunch_window",      # the window it belongs to (it may be
                                      # on show in the dashboard's)
    "command": "@tlaunch_command",
    "shim": "@tlaunch_shim",          # this script's pid: launch's process
    "target": "@tlaunch_target",      # the command's own pid
    "status": "@tlaunch_status",
    "stopped": "@tlaunch_stopped",
}

PROG = "tlaunch-pane"

#: Not passed into the pane: tmux sets them for it, or they describe this
#: process's own terminal (libtmux_easy's _tmux.SKIP_ENV). DIR_ENV is set below.
SKIP_ENV = ("TMUX", "TMUX_PANE", "TERM", "TERM_PROGRAM", "TERM_PROGRAM_VERSION",
            "COLUMNS", "LINES", DIR_ENV, "LTE_RUN_TEE")


def tmux(*args: str, check: bool = True) -> str:
    """Run one tmux command and return its stdout."""
    result = subprocess.run(
        ("tmux",) + args, capture_output=True, text=True, check=False
    )
    if check and result.returncode != 0:
        # The subcommand only: a split's arguments carry the whole environment.
        raise TmuxTrouble(f"tmux {args[0]}: {result.stderr.strip()}")
    return result.stdout.strip()


class TmuxTrouble(Exception):
    """tmux would not do something, and there is no pane as a result."""


# ------------------------------------------------------------------ the pane
def listen() -> tuple[str, socket.socket]:
    """A private directory with a listening socket for lte-run to call."""
    scratch = tempfile.mkdtemp(prefix="tlp-")
    path = os.path.join(scratch, SOCKET_NAME)
    if len(path.encode()) > 107:                # AF_UNIX's sun_path limit
        os.rmdir(scratch)
        scratch = tempfile.mkdtemp(prefix="tlp-", dir="/tmp")
        path = os.path.join(scratch, SOCKET_NAME)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    server.listen(1)
    os.mkfifo(os.path.join(scratch, "out"))
    return scratch, server


def open_output(scratch: str) -> tuple[int, int]:
    """The FIFO lte-run copies the pane's output to: our read end, and a write
    end held so it never reads as ended between writers. Open before the pane
    exists: lte-run refuses a FIFO with no reader rather than block."""
    path = os.path.join(scratch, "out")
    read = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    return read, os.open(path, os.O_WRONLY | os.O_NONBLOCK)


def open_pane(window: str, runner: str, scratch: str, command: list[str]) -> str:
    """Split `window` and run `command` under lte-run in the new pane.

    The environment is passed explicitly, because the tmux server forks this
    process and would otherwise give it the server's own -- which, when the
    session is one the user already had open, predates the workspace being
    sourced and would leave a ROS node unable to find anything. Given as
    separate arguments, the command is exec'd by tmux with no shell.
    """
    env = [part for name, value in os.environ.items() if name not in SKIP_ENV
           for part in ("-e", f"{name}={value}")]
    env += ["-e", f"{DIR_ENV}={scratch}"]
    argv = [runner, "--tee", os.path.join(scratch, "out"), "--", *command]
    try:
        return _split(window, env, argv)
    except TmuxTrouble:
        # Out of room, most likely: close the panes whose process has already
        # finished and try once more.
        prune(window)
        return _split(window, env, argv)


def _split(window: str, env: list[str], argv: list[str]) -> str:
    return tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", window,
                "-c", os.getcwd(), *env, *argv)


def prune(window: str) -> None:
    """Close panes nothing is running in any more, to make room for one that is."""
    listing = tmux("list-panes", "-t", window, "-F", "#{pane_id}|#{pane_dead}",
                   check=False)
    for entry in listing.split("\n"):
        pane, dead = (entry.split("|") + ["", ""])[:2]
        if dead == "1":
            tmux("kill-pane", "-t", pane, check=False)


def pane_gone(pane: str) -> bool:
    """Has the pane's process ended (or the pane been closed)?

    A pane that no longer exists is recognised by the *empty* answer, not by
    an error: `display-message` for a missing pane id succeeds and prints an
    empty format.
    """
    out = tmux("display-message", "-p", "-t", pane, "#{pane_dead}", check=False)
    return out != "0"


def mark(pane: str, **values) -> None:
    """Set some of this pane's OPTION values, in one tmux call."""
    args: list[str] = []
    for key, value in values.items():
        args += [";"] if args else []
        args += ["set-option", "-p", "-t", pane, OPTION[key], str(value)]
    if args:
        tmux(*args, check=False)


# ---------------------------------------------------------------- the ending
def die_by(signum: int) -> int:
    """End this process with `signum`, the way the pane's command ended.

    A process cannot *return* "killed by SIGKILL" -- so to pass that on
    faithfully, this one takes the same signal. Launch then records the
    returncode as ``-9``, exactly as if it had started the command itself.
    Falls back to the shell's 128+N if the signal cannot be raised.
    """
    try:
        signal.signal(signum, signal.SIG_DFL)
    except (OSError, ValueError):
        # SIGKILL and SIGSTOP cannot be reset -- and need no resetting, since
        # they could never have been caught. Carry on and raise it.
        pass
    try:
        os.kill(os.getpid(), signum)
        time.sleep(1)                     # the signal is on its way
    except OSError:
        pass
    return 128 + signum


class Runner:
    """This end of lte-run's socket: events in, signals out."""

    def __init__(self, server: socket.socket, pane: str, out: int, hold: int):
        self.server, self.pane = server, pane
        self.out: int | None = out        # the FIFO lte-run --tee writes to
        self.hold: int | None = hold      # our own write end, so no EOF early
        self.partial = b""
        self.conn: socket.socket | None = None
        self.pending: list[int] = []      # signals that arrived before lte-run
        self.first_signal: float | None = None
        self.last_signal: int | None = None
        self.killed = False
        self.buffer = b""
        self.ended: dict | None = None

    def signal(self, signum: int) -> None:
        if self.first_signal is None:
            self.first_signal = time.monotonic()
        self.last_signal = signum
        if self.conn is None:
            self.pending.append(signum)
            return
        try:
            self.conn.sendall(
                (json.dumps({"cmd": "signal", "signal": signum}) + "\n").encode())
        except OSError:
            pass

    def relay(self) -> bool:
        """Pass what the pane printed on to this script's stdout, where launch
        reads it. False once the copy has ended."""
        try:
            chunk = os.read(self.out, 65536)
        except BlockingIOError:
            return True
        except OSError:
            chunk = b""
        if not chunk:
            os.close(self.out)
            self.out = None
            self.flush(final=True)
            return False
        self.partial += chunk
        self.flush()
        return True

    def flush(self, final: bool = False) -> None:
        *lines, self.partial = self.partial.split(b"\n")
        if final and self.partial:
            lines, self.partial = lines + [self.partial], b""
        text = b"".join(line + b"\n" for line in lines)
        if text:
            try:
                sys.stdout.buffer.write(text)
                sys.stdout.buffer.flush()
            except OSError:
                pass

    def connect(self) -> bool:
        """Wait for lte-run to call in. False if its pane died first."""
        deadline = time.monotonic() + CONNECT
        while time.monotonic() < deadline:
            if select.select([self.server], [], [], 0.2)[0]:
                self.conn, _ = self.server.accept()
                for signum in self.pending:
                    self.signal(signum)
                return True
            if pane_gone(self.pane):
                return False
        return False

    def read(self) -> bool:
        """Take in what lte-run sent. False once it has hung up."""
        try:
            chunk = self.conn.recv(4096)
        except InterruptedError:
            return True
        except OSError:
            return False
        if not chunk:
            return False
        self.buffer += chunk
        *lines, self.buffer = self.buffer.split(b"\n")
        for line in lines:
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if message.get("event") == "started":
                mark(self.pane, target=message.get("target_pid", ""))
            elif message.get("event") == "exited":
                self.ended = message
        return True

    def wait(self) -> None:
        """Until lte-run hangs up, killing the command if it outstays GRACE."""
        while True:
            watched = [self.conn] + ([self.out] if self.out is not None else [])
            ready = select.select(watched, [], [], 0.5)[0]
            if self.out in ready:
                self.relay()
            if self.conn in ready and not self.read():
                return
            late = (self.first_signal is not None and not self.killed
                    and time.monotonic() - self.first_signal > GRACE)
            if late:
                self.killed = True
                self.signal(signal.SIGKILL)


def drain(runner: Runner) -> None:
    """The rest of the pane's output. lte-run has written all of it before it
    reports the exit, so what is left is already in the FIFO."""
    while runner.out is not None:
        try:
            chunk = os.read(runner.out, 65536)
        except BlockingIOError:
            break
        except OSError:
            chunk = b""
        if not chunk:
            break
        runner.partial += chunk
        runner.flush()
    runner.flush(final=True)
    for fd in (runner.out, runner.hold):
        if fd is not None:
            os.close(fd)


def run(server: socket.socket, pane: str, out: int, hold: int) -> int:
    """Wait for the pane's command, and end the same way it did."""
    runner = Runner(server, pane, out, hold)
    signal.signal(signal.SIGINT, lambda signum, _frame: runner.signal(signum))
    signal.signal(signal.SIGTERM, lambda signum, _frame: runner.signal(signum))

    if runner.connect():
        runner.wait()
    drain(runner)
    ended = runner.ended
    if ended is None:
        # lte-run never called in, or went without a word: the pane was closed
        # by hand, or taken away. Call that a hangup, so the run cannot look
        # successful.
        tmux("kill-pane", "-t", pane, check=False)
        return die_by(signal.SIGHUP)
    status = ended.get("code") if ended.get("signal") is None else -ended["signal"]
    stopped = runner.last_signal
    mark(pane, status=status,
         **({"stopped": signal.Signals(stopped).name} if stopped else {}))
    if ended.get("signal") is not None:
        return die_by(ended["signal"])
    return ended.get("code") or 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__.split("\n\n")[0])
    parser.add_argument("--window", required=True, help="tmux window to split")
    parser.add_argument("--runner", default="lte-run",
                        help="lte-run, which runs the command inside the pane")
    parser.add_argument("--title", default="", help="pane title")
    parser.add_argument("--layout", default="tiled", help="layout to re-apply")
    parser.add_argument(
        "--retire", default="",
        help="a pane to close once ours exists -- the shell tmux insists on "
        "creating a window with, which no process will ever use. Closing it "
        "from tlaunch is not possible: a window with no panes is a window that "
        "has gone, so it can only go once something real is beside it",
    )
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)

    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("no command given")

    scratch, server = listen()
    out, hold = open_output(scratch)
    try:
        pane = open_pane(args.window, args.runner, scratch, command)
    except TmuxTrouble as exc:
        os.close(out)
        os.close(hold)
        server.close()
        shutil.rmtree(scratch, ignore_errors=True)
        # No pane to be had -- so be the process instead of failing. This is
        # exactly what launch would have started, with this script's own pid,
        # so the run carries on with its output back in launch's log.
        print(f"{PROG}: {exc}; running it here instead", file=sys.stderr, flush=True)
        os.execvp(command[0], command)

    title = args.title or command[0]
    window = args.window.rpartition(":")[2]
    tmux("select-pane", "-t", pane, "-T", title, check=False)
    mark(pane, name=title, window=window, command=" ".join(command), shim=os.getpid())
    # The window's remain-on-exit covers the start; this one goes with the pane
    # when the dashboard swaps it into its own window to show it.
    tmux("set-option", "-p", "-t", pane, "remain-on-exit", "on", check=False)
    if args.retire:
        tmux("kill-pane", "-t", args.retire, check=False)
    if args.layout:
        tmux("select-layout", "-t", args.window, args.layout, check=False)
    try:
        return run(server, pane, out, hold)
    finally:
        server.close()
        shutil.rmtree(scratch, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
