# lte_launch_install_stubs(<python package> <module>...)
#
# Lets stock launch find typed launches (Q17). For each module, installs a stub
# share/${PROJECT_NAME}/launch/<module>.py that imports it by module path, so its
# relative imports keep working. Then `ros2 launch ${PROJECT_NAME} <module>.py`
# runs it and a stock file can include it, with one launch argument per field.
#
#   lte_launch_install_stubs(${PROJECT_NAME}.launch turtle_demo_launch)
function(lte_launch_install_stubs package)
  if(NOT ARGN)
    message(FATAL_ERROR "lte_launch_install_stubs(${package}): no modules given")
  endif()
  foreach(module ${ARGN})
    set(stub "${CMAKE_CURRENT_BINARY_DIR}/lte_launch_stubs/${module}.py")
    file(WRITE "${stub}"
      "# Generated by lte_launch_install_stubs(): stock launch's way in.\n"
      "from ${package}.${module} import generate_launch_description  # noqa: F401\n")
    install(FILES "${stub}" DESTINATION share/${PROJECT_NAME}/launch)
  endforeach()
endfunction()
